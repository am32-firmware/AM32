{
    "OS": "linux",
    "makefile.makePath": "/usr/bin/make",

    "makefile.configureOnOpen": true,
    "makefile.phonyOnlyTargets": true,
    "makefile.configurations": [
        {
            "name": "MakeSingle",
            "makeArgs": [
                "-j1"
            ]
        },
            {
                "name": "MakeParallel-8",
                "makeArgs": [
                    "-j8"
                ]
        },
            {
            "name": "MakeParallel-MAX",
                "makeArgs": [
            "-j"
                ]
        }
    ]
}