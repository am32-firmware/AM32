{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
      {
        "name": "AM32 SITL (ESCSim GUI)",
        "type": "cppdbg",
        "request": "launch",
        "program": "${workspaceFolder}/build/sitl/AM32_SITL_CAN",
        "cwd": "${workspaceFolder}/build/sitl",
        "args": ["--eeprom", "vscode_eeprom.bin", "--input-type", "1",
                 "--input-port", "57733", "--state-port", "57734",
                 "--can-uri", "mcast:0", "--nosleep", "--verbose",
                 "--wait-for-input", "--exit-on-reset",
                 "--log-file", "vscode-sitl.log"],
        "preLaunchTask": "AM32 SITL: Build for Run",
        "MIMode": "gdb",
        "miDebuggerPath": "/usr/bin/gdb",
        "setupCommands": [
          {"text": "handle SIGUSR1 nostop noprint pass", "description": "Allow SITL interrupt delivery"}
        ],
        "stopAtEntry": false,
        "externalConsole": false,
        "windows": {
          "program": "${workspaceFolder}/build/sitl/AM32_SITL_CAN.exe",
          "miDebuggerPath": "${config:am32.sitl.gdbPath}",
          "avoidWindowsConsoleRedirection": true
        }
      },
      // STLink configuration
      {
        "name": "AM32 STLink",
        "cwd": "${workspaceFolder}",
        "executable": "${workspaceFolder}/obj/debug.elf",
        "liveWatch": {
            "enabled": true,
            "samplesPerSecond": 4,
	},
	"svdFile": "obj/debug.svd",
        "request": "launch",
        "type": "cortex-debug",
        "servertype": "openocd",
	      "configFiles": [
	    "${workspaceFolder}/obj/openocd.cfg",
        ],
	      "showDevDebugOutput": "none",
        "osx": {
            "serverpath": "${workspaceFolder}/tools/macos/openocd/bin/openocd",
            "armToolchainPath": "${workspaceFolder}/tools/macos/xpack-arm-none-eabi-gcc-10.3.1-2.3/bin"
        },
        "linux": {
            "serverpath": "${workspaceFolder}/tools/linux/openocd/bin/openocd",
            "armToolchainPath": "${workspaceFolder}/tools/linux/xpack-arm-none-eabi-gcc-10.3.1-2.3/bin"
        },
        "windows": {
            "serverpath": "${workspaceFolder}\\tools\\windows\\openocd\\bin\\openocd",
            "armToolchainPath": "${workspaceFolder}\\tools\\windows\\xpack-arm-none-eabi-gcc-10.3.1-2.3\\bin"
        }
      },

      // JLink configuration
      {
        "type": "cortex-debug",
        "request": "launch",
        "name": "AM32 JLink",
	"svdFile": "obj/debug.svd",
	"cwd": "${workspaceRoot}",
	      "device" : "-AT32F421K8U7",
        "osx": {
            "gdbPath": "${workspaceRoot}/tools/macos/xpack-arm-none-eabi-gcc-10.3.1-2.3/bin/arm-none-eabi-gdb"
        },
        "linux": {
            "gdbPath": "${workspaceRoot}/tools/linux/xpack-arm-none-eabi-gcc-10.3.1-2.3/bin/arm-none-eabi-gdb"
        },
        "windows": {
            "gdbPath": "${workspaceRoot}\\tools\\windows\\xpack-arm-none-eabi-gcc-10.3.1-2.3\\bin\\arm-none-eabi-gdb"
        },
        "executable": "${workspaceRoot}/obj/debug.elf",
	      "showDevDebugOutput": "raw",
        "servertype" : "jlink",
        "swoConfig": {
          "enabled": false,
        },
        "serialNumber": "", 
        "liveWatch": {
          "enabled": true,
          "samplesPerSecond": 4
        }
      }
    ]
  }
