# SEQURE 4in1 G431 ESC + GT2215 motor, no prop
# as dumped from the bench ESC for the calibration captures
#
# eeprom parameters as stored (bytes). Anything not listed keeps
# the firmware default from default_settings[] in
# Src/DroneCAN/DroneCAN.c; the image is generated by
# Mcu/SITL/sitl_params.py, never committed as a binary.

MOTOR_KV                  27   # 1100 Kv
TEMPERATURE_LIMIT        255   # off
CURRENT_LIMIT              0   # 0 A
INPUT_SIGNAL_TYPE          0   # auto
CAN_NODE                  30   # node 30
ESC_INDEX                  0
REQUIRE_ARMING             0   # off
# the rate sweep1.jsonl was captured at; the recon dump predates it and
# still held the 25 Hz default
TELEM_RATE                50   # 50 Hz
REQUIRE_ZERO_THROTTLE      1   # on
FILTER_HZ                  0   # 0 Hz
DEBUG_RATE                50   # 50 Hz
